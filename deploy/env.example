# /root/pubmed_search/.env — read by both systemd units. install.sh creates it
# with a random internal key if it does not exist. Never commit the real file.
MSS_INTERNAL_KEY=change-me
MSS_BACKEND_URL=http://127.0.0.1:8080
MSS_API_HOST=127.0.0.1
MSS_API_PORT=8080
MSS_MAX_CONCURRENT_SEARCHES=2
MSS_QUEUE_TIMEOUT_S=20
MSS_UPDATE_INTERVAL_S=3600
# Optional: enable POST /keys/generate
# MSS_ADMIN_SECRET=
